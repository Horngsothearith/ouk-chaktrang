# The project has no npm dependencies, but keep a stray install out of history.
node_modules/
npm-debug.log*

# Git worktrees created for feature work (see .dockerignore).
.worktrees/

# Compose reads this for TS_AUTHKEY and friends - it holds a live auth key.
.env

# OS and editor cruft.
.DS_Store
Thumbs.db
*.swp

# Generated by the browser preview tooling, not part of the app.
.claude/settings.local.json
